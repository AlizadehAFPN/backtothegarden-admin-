# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local
# .env.local is git-ignored; never commit real keys.
#
# Staging (`yarn staging`): also create .env.staging with the staging project's
# values. Its NEXT_PUBLIC_FIREBASE_* and FIREBASE_SERVICE_ACCOUNT* keys override
# .env.local (see next.config.ts). The script sets BACKTOTHEGARDEN_ENV itself;
# don't put it in this file.

# --- Admin panel login (lib/admin-credentials.ts) ---
# Required. There are no built-in defaults; login fails while these are empty.
# ADMIN_PASSWORD is the starting password. After it is changed in the panel
# (Security page), a scrypt hash in Firestore (AdminSettings/credentials)
# replaces it for every environment that uses this Firebase project. Forgot it?
# Delete that document in the Firebase console and ADMIN_PASSWORD works again.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the btg-session cookie. Falls back to ADMIN_PASSWORD when empty, but set it.
# Changing it (or the password) logs every admin out.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Firebase web app config (lib/firebase.ts; the bucket is also used by app/api/storage) ---
# Firebase Console > Project settings > General > Your apps > SDK setup and configuration
# NEXT_PUBLIC_ values are built into the browser bundle: rebuild/redeploy after changing them.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# --- RevenueCat (app/api/subscription/sync) ---
# Secret API key (v1, starts with sk_). The mobile app calls /api/subscription/sync,
# which checks purchases with RevenueCat and writes user_type / user_isMembresy.
# RevenueCat dashboard > Project settings > API keys > + New secret API key.
# Server-only: never prefix it with NEXT_PUBLIC_.
REVENUECAT_SECRET_API_KEY=

# --- Firebase Admin SDK service account (lib/firebase-admin.ts) ---
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Set ONE of these; they are checked in this order:
#   1. FIREBASE_SERVICE_ACCOUNT_PATH (or GOOGLE_APPLICATION_CREDENTIALS): path to the
#      downloaded .json file. Keep it in secrets/, which is git-ignored. Local only.
#   2. FIREBASE_SERVICE_ACCOUNT_KEY_BASE64: the .json file base64-encoded on one line:
#        base64 -i service-account.json | tr -d '\n'
#   3. FIREBASE_SERVICE_ACCOUNT_KEY: the JSON minified onto ONE line, with the private
#      key's line breaks written as \n (the format lib/firebase-admin.ts expects).
# On Vercel / Netlify / Cloudflare Pages use option 2 or 3; a file path won't exist there.
#
# Option 3 looks like:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
FIREBASE_SERVICE_ACCOUNT_KEY=
